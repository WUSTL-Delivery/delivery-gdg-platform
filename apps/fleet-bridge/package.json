{
  "name": "fleet-bridge",
  "version": "0.1.0",
  "private": true,
  "description": "Bridges fleet-platform events (presence, telemetry, intervention) into the club's Kafka topics. One direction only: platform -> Kafka.",
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "node --experimental-strip-types src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "kafkajs": "^2.2.4"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
