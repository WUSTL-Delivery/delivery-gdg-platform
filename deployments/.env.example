# Copy to deployments/.env — never commit the real file.
# Supabase now issues "publishable" (sb_publishable_...) and "secret" (sb_secret_...)
# API keys in place of the legacy anon / service_role JWTs.

# Supabase project (shared by authoritative + web)
SUPABASE_URL=https://xxxx.supabase.co
# secret key (sb_secret_...) — server-side only. Used by the Go authoritative
# server and by the Next.js API routes. Bypasses RLS; never ship it to a browser.
SUPABASE_SECRET_KEY=
# publishable key (sb_publishable_...) — safe for clients. Not used by the
# current web build (it talks to the DB only via server routes); reserved for
# the auth example in apps/authoritative and any future client-side Supabase.
SUPABASE_PUBLISHABLE_KEY=

# Signs the auth-token cookie issued by /api/signin
JWT_SECRET=change-me

# Prod only (docker-compose.prod.yml / Caddy)
DOMAIN_NAME=example.com

# Fleet platform (fleet-server + apps/fleet-bridge).
# The fleet enrollment key. YOU choose it (>= 16 chars):
#   openssl rand -hex 24
# fleet-server registers it for club-fleet on every start (idempotent); the
# bridge and every robot present it once to enroll, then keep their own tokens.
# Treat it like a password: it lets anyone register a robot into the fleet.
FLEET_ENROLL_KEY=
# Admin token for fleetctl and the console's operator invites (>= 16 chars):
#   openssl rand -hex 32
# Leave empty locally to keep the admin API off. Anyone holding it can mint
# operator invites and revoke robots, so treat it like a root password.
FLEET_ADMIN_TOKEN=
# Optional override of the image pin in docker-compose.yml (normally leave unset;
# the pin in git is the contract between the repos).
# FLEET_SERVER_IMAGE=ghcr.io/wustl-delivery/fleet-server:0.2.0
